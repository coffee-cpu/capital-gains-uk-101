{
  "name": "cgt-visualiser",
  "version": "0.3.1",
  "description": "UK capital gains tax calculator for share transactions from broker CSV exports. Applies HMRC same-day, 30-day and Section 104 matching rules. Runs locally; your data never leaves your machine.",
  "type": "module",
  "bin": {
    "cgt-visualiser": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p . && node build.mjs",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "capital-gains-tax",
    "cgt",
    "uk",
    "hmrc",
    "section-104",
    "tax-calculator",
    "cli",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffee-cpu/capital-gains-uk-101.git",
    "directory": "packages/cli"
  },
  "homepage": "https://cgtvisualiser.co.uk",
  "bugs": {
    "url": "https://github.com/coffee-cpu/capital-gains-uk-101/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.10"
  }
}
